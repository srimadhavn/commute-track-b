    {
      "id": 13,
      "type": "logs",
      "title": "All logs (use the Service menu at the top)",
      "description": "Everything, filtered by the Service menu. Use the search box in Grafana's Explore for free-text search.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
