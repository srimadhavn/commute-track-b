    {
      "id": 15,
      "type": "timeseries",
      "title": "ORS error ratio (5 min)",
      "description": "Share of ORS calls that failed. The core hides these by falling back to estimates, so this is the only place an outage or exhausted quota shows up.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
