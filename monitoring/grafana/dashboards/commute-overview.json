      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Responses by status code",
      "description": "2xx = success, 4xx = the caller sent something invalid or out of area, 5xx = our fault.",
      "datasource": {
