      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(ors_requests_total{result=\"error\"}[5m])) or vector(0)) / sum(rate(ors_requests_total[5m]))",
