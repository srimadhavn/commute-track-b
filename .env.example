# Copy to .env and fill in. .env is gitignored. NEVER commit real values or paste them into chat.

# OpenRouteService key (free): https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# Database. Use letters and digits only for the password (keeps things simple and URL-safe).
POSTGRES_USER=commute
POSTGRES_PASSWORD=
POSTGRES_DB=commute

# Host ports (bound to 127.0.0.1 only). 5433 avoids clashing with a local Postgres on 5432.
API_HOST_PORT=3000
DB_HOST_PORT=5433

# Who may call the API from a browser. "*" is fine locally; set the real origin when deployed.
CORS_ORIGIN=*

# How often the ingestor fetches Citi Bike GBFS (seconds)
INGEST_INTERVAL_SEC=120

# Monitoring (B2). Grafana login is user "admin" with this password. Letters and digits only.
GRAFANA_ADMIN_PASSWORD=
GRAFANA_HOST_PORT=3001
PROMETHEUS_HOST_PORT=9090

# Logging (B2b)
LOKI_HOST_PORT=3100
ALLOY_HOST_PORT=12345
